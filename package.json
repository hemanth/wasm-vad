{
  "name": "wasm-vad",
  "version": "0.1.0",
  "description": "Streaming 16 kHz voice activity detection for browsers and Node.js via capability-routed WebGPU/WASM SIMD ONNX specialists (432 KiB mobile / 1.24 MB studio), AudioWorklet anti-aliased capture, and zero-dep spectral-LRT fallback.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "wasm-vad": "bin/wasm-vad.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "bin",
    "models/vad-mobile.onnx",
    "models/vad-studio.onnx",
    "models/manifest.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs",
    "bench": "node bench/run-bench.mjs",
    "verify:browser": "node verify-browser.mjs",
    "playground": "node serve-playground.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "vad",
    "voice-activity-detection",
    "wasm",
    "webgpu",
    "onnx",
    "silero",
    "audioworklet",
    "speech",
    "asr",
    "stt",
    "turn-taking",
    "webrtc",
    "zero-dependency"
  ],
  "peerDependencies": {
    "onnxruntime-web": ">=1.18.0",
    "onnxruntime-node": ">=1.18.0"
  },
  "peerDependenciesMeta": {
    "onnxruntime-web": {
      "optional": true
    },
    "onnxruntime-node": {
      "optional": true
    }
  },
  "homepage": "https://hemanth.github.io/wasm-vad/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hemanth/wasm-vad.git"
  },
  "bugs": {
    "url": "https://github.com/hemanth/wasm-vad/issues"
  },
  "author": "Hemanth HM <hemanth@h3manth.com> (https://h3manth.com)",
  "license": "MIT"
}
